DATABASE_URL=postgres://user:password@localhost:5432/workorder_generator
DB_POOL_MAX=10
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4173
AUTH_TRUSTED_ORIGINS=http://localhost:4173
AUTH_IP_ADDRESS_HEADERS=x-real-ip

# Account invitation and password recovery email. Keep SMTP_PASS only in
# local/Railway secrets.
# Gmail requires MAIL_FROM_EMAIL to match the authenticated mailbox or a
# verified send-as alias.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Workorder
MAIL_FROM_EMAIL=

# One-time first administrator bootstrap. Run `npm run db:create-admin`, then
# remove ADMIN_PASSWORD from the environment after the command succeeds.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_NAME=
ADMIN_PASSWORD=
COMPANY_NAME=
COMPANY_SLUG=
LOCATION_NAME=

# Local/demo identities only. Never enable this seed in production.
DEMO_USER_PASSWORD=
ALLOW_DEMO_USER_SEED=false
SAMSARA_API_TOKEN=
SAMSARA_API_BASE_URL=https://api.samsara.com
SAMSARA_OAUTH_CLIENT_ID=
SAMSARA_OAUTH_CLIENT_SECRET=
SAMSARA_OAUTH_REDIRECT_URI=http://localhost:4173/api/integrations/samsara/oauth/callback
SAMSARA_SYNC_INTERVAL_MINUTES=30
SAMSARA_SYNC_ON_STARTUP=true

# 32 random bytes encoded as base64. Generate once per environment and store
# only in the deployment secret manager. Rotations increment the key version.
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY_VERSION=v1
INTEGRATION_JOB_POLL_MS=5000
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
NEXT_PUBLIC_HERE_API_KEY=

OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
PARTS_HELPER_OPENAI_MODEL=gpt-5.6-sol
INVOICE_EXTRACTION_OPENAI_MODEL=gpt-5.6-terra
INVOICE_EXTRACTION_MAX_CONCURRENT=4
INVOICE_EXTRACTION_WORKER_MAX_ATTEMPTS=2
INVOICE_EXTRACTION_WORKER_CONCURRENCY=2
INVOICE_EXTRACTION_WORKER_POLL_MS=1000
# Optional local-first OCR service. Bind it to loopback for development. A
# non-loopback production endpoint requires HTTPS; set INVOICE_OCR_TOKEN when
# the service is reachable outside the application host.
INVOICE_OCR_BASE_URL=http://127.0.0.1:8091
INVOICE_OCR_TOKEN=
INVOICE_OCR_TIMEOUT_MS=60000
INVOICE_OCR_MAX_CONCURRENT=1
INVOICE_TEMPLATE_PROMOTION_EXAMPLES=3
# Required in production before invoice upload. Use a separate 32-byte random
# base64 key stored only in the secret manager. Local development creates a
# permission-restricted ignored key file once and reuses it.
INVOICE_DOCUMENT_ENCRYPTION_KEY=
INVOICE_DOCUMENT_ENCRYPTION_KEY_VERSION=v1
# JSON map of retained historical version to 32-byte base64 key.
INVOICE_DOCUMENT_ENCRYPTION_KEYS=
INVOICE_DOCUMENT_RETENTION_DAYS=365

# Dedicated opening-count workbook encryption. When blank, current invoice
# document key/version is used. Historical decrypt checks both keyrings.
INVENTORY_COUNT_FILE_ENCRYPTION_KEY=
INVENTORY_COUNT_FILE_ENCRYPTION_KEY_VERSION=
INVENTORY_COUNT_FILE_ENCRYPTION_KEYS=
INVENTORY_COUNT_FILE_RETENTION_DAYS=365

# Required before any serialized inventory receipt or QR label is created.
# Generate exactly 32 random bytes and encode them as base64 or 64 hex characters.
INVENTORY_QR_SIGNING_KEY=
PARTS_HELPER_HF_DATASET=partsnow/us-heavy-duty-trucks
PARTS_HELPER_HF_CACHE_MINUTES=360
HF_TOKEN=

# Optional WProofreader service. Keep the service ID server-side; browsers call
# only the authenticated /api/proofreading/check endpoint.
PROOFREADING_PROVIDER=wproofreader
WPROOFREADER_SERVICE_ID=
PROOFREADING_TIMEOUT_MS=3000
PROOFREADING_DEEP_TIMEOUT_MS=5000
PROOFREADING_CACHE_TTL_MS=30000
PROOFREADING_CACHE_MAX_ENTRIES=250
PROOFREADING_CONCURRENCY_LIMIT=4
PROOFREADING_RECOVERY_MAX_CHARS=1200
# Deep checks run only on blur. Both the WProofreader AI pass and the optional
# contextual adapter remain disabled until this explicit gate is enabled.
PROOFREADING_DEEP_MODE_ENABLED=false
PROOFREADING_CONTEXT_PROVIDER=disabled
PROOFREADING_CONTEXT_TIMEOUT_MS=5000
PROOFREADING_CONTEXT_MIN_CONFIDENCE=95
PROOFREADING_OPENAI_MODEL=gpt-5.6-luna
# Synthetic benchmark release thresholds. The benchmark is an explicit live
# command and is not part of npm run verify.
PROOFREADING_BENCHMARK_MIN_RECALL=0.75
PROOFREADING_BENCHMARK_MAX_P95_MS=6000
PROOFREADING_BENCHMARK_MAX_UNEXPECTED=5
# Persistent runtime files (generated PDFs, uploads, shares, and chat images).
# Railway mounts its application volume at this path.
WORKORDER_STORAGE_DIR=
